#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEST_PYTHON="${PYTHON:-python3}"
INTEGRATION_PATH="custom_components.efteling_park"

cd "$ROOT"

if ! "$TEST_PYTHON" -c "import pytest; import pytest_cov; import pytest_homeassistant" 2>/dev/null ||
    "$TEST_PYTHON" -m pip show pytest-homeassistant-custom-component >/dev/null 2>&1; then
    PYTHON="$TEST_PYTHON" "${ROOT}/scripts/setup"
fi

COVERAGE_ARGS=()
PYTEST_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cov)
            COVERAGE_ARGS+=("--cov=${INTEGRATION_PATH}" "--cov-report=term-missing")
            shift
            ;;
        --cov-html)
            COVERAGE_ARGS+=("--cov=${INTEGRATION_PATH}" "--cov-report=html")
            shift
            ;;
        *)
            PYTEST_ARGS+=("$1")
            shift
            ;;
    esac
done

exec "$TEST_PYTHON" -m pytest \
    "${COVERAGE_ARGS[@]}" \
    "${PYTEST_ARGS[@]}"
