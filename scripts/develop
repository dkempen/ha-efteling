#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

ROOT="${PWD}"
CONFIG="${ROOT}/config"
DEV_COMPONENTS="${ROOT}/custom_components"
CONFIG_COMPONENTS="${CONFIG}/custom_components"

# Create config directory if not present
if [[ ! -d "${CONFIG}" ]]; then
    mkdir -p "${CONFIG}"
    hass --config "${CONFIG}" --script ensure_config
fi

# Keep the development integration and installed integrations discoverable.
mkdir -p "${CONFIG_COMPONENTS}"

# Link the development integration into Home Assistant's expected directory.
if [[ ! -e "${CONFIG_COMPONENTS}/efteling" ]]; then
    ln -s "${DEV_COMPONENTS}/efteling" "${CONFIG_COMPONENTS}/efteling"
fi

# Start Home Assistant
hass --config "${CONFIG}" --debug
