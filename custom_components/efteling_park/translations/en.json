  "config": {
    "step": {
      "user": {
        "title": "Efteling",
        "description": "Configure how Efteling information is retrieved and which entities are created.",
        "data": {
          "language": "Language",
          "create_attraction_status_sensors": "Create separate attraction status sensors"
        },
        "data_description": {
          "language": "This affects attraction and show names, descriptions, and other information.",
          "create_attraction_status_sensors": "Create an additional status sensor for every attraction.\nThe status is already available by default as an attribute on wait time sensor, so this is only needed to more easily monitor the status history."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Efteling",
        "description": "Update the Efteling integration settings.",
        "data": {
          "language": "Language",
          "create_attraction_status_sensors": "Create separate attraction status sensors"
        },
        "data_description": {
          "language": "This affects attraction and show names, descriptions, and other information.",
          "create_attraction_status_sensors": "Create an additional status sensor for every attraction.\nThe status is already available by default as an attribute on wait time sensor, so this is only needed to more easily monitor the status history."
        }
      }
    },
    "abort": { "reconfigure_successful": "Reconfiguration was successful." },
    "error": {
